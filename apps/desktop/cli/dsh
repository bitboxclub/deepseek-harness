#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# 本脚本随 runtime/ 一起安装，其上一级即 app.asar 所在目录，macOS 与 Linux 一致：
#   macOS: <App>.app/Contents/Resources
#   Linux: <dir>-unpacked/resources
# 可执行文件位置两者不同，按存在性选择，macOS 行为保持不变：
#   macOS: <App>.app/Contents/MacOS/DeepSeek Harness
#   Linux: <dir>-unpacked/deepseek-harness
executable="$resources/../MacOS/DeepSeek Harness"
[ -x "$executable" ] || executable="$resources/../deepseek-harness"
ELECTRON_RUN_AS_NODE=1 exec "$executable" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
